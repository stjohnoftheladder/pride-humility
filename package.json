{
  "name": "pride-humility",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pride vs. Humility — an Undertale-style Orthodox pilgrimage prototype (hybrid: 3D exploration + 2D battle screens), built on the wizard-castle pipeline.",
  "scripts": {
    "gen": "node tools/gen-sprites.js && node tools/gen-textures.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tests/run.mjs",
    "multiplayer:dev": "wrangler dev --config multiplayer-worker/wrangler.jsonc --ip 127.0.0.1 --port 8787",
    "multiplayer:check": "wrangler deploy --config multiplayer-worker/wrangler.jsonc --dry-run",
    "test:multiplayer": "node tests/multiplayer.mjs",
    "test:multiplayer:live": "node tests/live-multiplayer.mjs"
  },
  "dependencies": {
    "@daily-co/daily-js": "^0.94.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "vite": "^8.2.1",
    "wrangler": "^4.87.0"
  }
}
